  <script>
    // Dynamic Chart Generation
    const chartData = [
      { label: "Psych. Testing", weight: 100, count: 14, highlight: true },
      { label: "Emergence of Psych.", weight: 71, count: 10, highlight: false },
      { label: "Biological Basis", weight: 50, count: 7, highlight: false },
      { label: "Counselling", weight: 50, count: 7, highlight: false },
      { label: "Social Psychology", weight: 43, count: 6, highlight: false },
      { label: "Perception", weight: 43, count: 6, highlight: false },
      { label: "Human Development", weight: 43, count: 6, highlight: false },
      { label: "Intelligence", weight: 36, count: 5, highlight: false },
      { label: "Statistics", weight: 36, count: 5, highlight: false },
      { label: "Research Methods", weight: 29, count: 4, highlight: false },
      { label: "Personality", weight: 14, count: 2, highlight: false },
      { label: "Attention", weight: 7, count: 1, highlight: false },
    ];

    const chartContainerEl = document.getElementById('dynamic-chart-data');
    if (chartContainerEl) {
      let rowsHtml = '';
      chartData.forEach(item => {
        rowsHtml += `
        <div class="bar-row">
          <span class="bar-label">${item.label}</span>
          <div class="bar-track"><div class="bar-fill ${item.highlight ? 'highlight' : ''}" data-w="${item.weight}"></div></div>
          <span class="bar-count">${item.count}</span>
        </div>
      `;
      });
      chartContainerEl.innerHTML = rowsHtml;
    }

    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => entry.target.classList.add('visible'), i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    reveals.forEach(el => observer.observe(el));

    // Animate bars and stats when section enters view
    const chartObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // Animate Bars
          entry.target.querySelectorAll('.bar-fill').forEach((bar, i) => {
            setTimeout(() => {
              bar.style.width = bar.dataset.w + '%';
            }, i * 60);
          });

          // Animate Counters
          const counters = document.querySelectorAll('.counter');
          counters.forEach(counter => {
            const target = +counter.getAttribute('data-target');
            const suffix = counter.getAttribute('data-suffix') || '';
            const duration = 2000;
            const stepTime = Math.abs(Math.floor(duration / target));
            let current = 0;
            const timer = setInterval(() => {
              current += Math.ceil(target / 40); // increment size
              if (current >= target) {
                counter.innerText = target + suffix;
                clearInterval(timer);
              } else {
                counter.innerText = current + suffix;
              }
            }, stepTime);
          });

          chartObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    document.querySelectorAll('.chart-container').forEach(c => chartObserver.observe(c));

    // Email signup
    function handleSignup(btn) {
      const input = btn.parentElement.querySelector('.email-input');
      if (!input.value || !input.value.includes('@')) {
        input.style.borderColor = '#c0392b';
        input.focus();
        setTimeout(() => input.style.borderColor = '', 1200);
        return;
      }
      btn.innerHTML = 'You\'re on the list ✓';
      btn.style.background = '#1a3a2a';
      btn.disabled = true;
      input.disabled = true;
    }


  </script>
